<div class="card border mb-4">

    <!-- Form Header -->
    <div class="card-header bg-light d-flex justify-content-between align-items-center">

        <h6 class="mb-0">
            <i class="bi bi-person-plus me-2"></i>
            Add Project Member
        </h6>

        <button type="button" class="btn-close" aria-label="Close"
            onclick="document.getElementById('member-form-container').innerHTML = '';">
        </button>

    </div>

    <div class="card-body">

        <form hx-post="/projects/{{project_id}}/members" hx-target="#member-message" hx-swap="innerHTML"
            hx-disabled-elt="find button[type='submit']">

            <div class="row g-3">

                <div class="col-12">

                    <label class="form-label">
                        Select Employee
                        <span class="text-danger">*</span>
                    </label>

                    <select name="user_id" class="form-select" required {{#unless hasEmployees}}disabled{{/unless}}>

                        <option value="">
                            Select an eligible employee
                        </option>

                        {{#each employees}}

                        <option value="{{user_id}}">
                            {{employee_name}} — {{role_name}} ({{email}})
                        </option>

                        {{/each}}

                    </select>

                    <div class="form-text">
                        Only active employees from the project's company
                        who are not already project members are displayed.
                    </div>

                    {{#unless hasEmployees}}

                    <div class="alert alert-info mt-3 mb-0">
                        <i class="bi bi-info-circle me-2"></i>
                        No eligible employees are available for assignment.
                    </div>

                    {{/unless}}

                </div>

            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">

                <button type="button" class="btn btn-outline-secondary"
                    onclick="document.getElementById('member-form-container').innerHTML = '';">
                    Cancel
                </button>

                <button type="submit" class="btn btn-primary" {{#unless hasEmployees}}disabled{{/unless}}>

                    <i class="bi bi-person-plus me-1"></i>
                    Add Member
                </button>

            </div>

        </form>

    </div>

</div>