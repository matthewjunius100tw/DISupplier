<div id="category-results" hx-get="/material-categories/list"
    hx-trigger="category-added from:body, category-deleted from:body" hx-include="#category-page-size" hx-target="this"
    hx-swap="outerHTML">

    <!-- Page Size and Total Results -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <div class="d-flex align-items-center gap-2">

            <label for="category-page-size" class="form-label mb-0">
                Show
            </label>

            <select id="category-page-size" name="page_size" class="form-select form-select-sm" style="width: 90px;"
                hx-get="/material-categories/list" hx-trigger="change" hx-target="#category-results"
                hx-swap="outerHTML">

                {{#each pageSizeOptions}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>
                    {{value}}
                </option>
                {{/each}}

            </select>

            <span>per page</span>
        </div>

        <span class="text-muted">
            Total: {{total}} categories
        </span>

    </div>

    <!-- Categories Table -->
    <div class="table-responsive">

        <table class="table table-striped table-hover align-middle"
            style="table-layout: fixed; width: 100%; min-width: 850px;">

            <thead class="table-light">
                <tr>
                    <th style="width: 20%;">Category Name</th>
                    <th style="width: 35%;">Description</th>
                    <th style="width: 15%;" class="text-center">
                        Materials Count
                    </th>
                    <th style="width: 12%;" class="text-center">
                        Status
                    </th>
                    <th style="width: 18%;" class="text-center">
                        Actions
                    </th>
                </tr>
            </thead>

            <tbody id="category-table-body">

                {{#each data}}
                {{> material_categories/row}}
                {{else}}
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">
                        No material categories found.
                    </td>
                </tr>
                {{/each}}

            </tbody>

        </table>

    </div>

    <!-- Pagination Controls -->
    <div class="mt-3 mb-4">

        <!-- Results Information -->
        <div class="text-end text-muted small mb-3">
            Showing {{startRecord}}–{{endRecord}} of {{total}} categories
        </div>

        <!-- Centered Pagination -->
        <nav aria-label="Material Categories pagination" class="d-flex justify-content-center">

            <div class="d-flex align-items-center gap-1 flex-wrap justify-content-center">

                <!-- First Page -->
                <button type="button" class="btn btn-outline-secondary btn-sm" title="First page" {{#unless
                    hasPrevious}}disabled{{/unless}} hx-get="/material-categories/list?page={{firstPage}}"
                    hx-include="#category-page-size" hx-target="#category-results" hx-swap="outerHTML">
                    <i class="bi bi-chevron-double-left"></i>
                </button>

                <!-- Previous Page -->
                <button type="button" class="btn btn-outline-secondary btn-sm" title="Previous page" {{#unless
                    hasPrevious}}disabled{{/unless}} hx-get="/material-categories/list?page={{previousPage}}"
                    hx-include="#category-page-size" hx-target="#category-results" hx-swap="outerHTML">
                    <i class="bi bi-chevron-left"></i>
                </button>

                <!-- Up to Five Page Numbers -->
                {{#each pages}}

                <button type="button" class="btn btn-sm {{#if active}}btn-primary{{else}}btn-outline-secondary{{/if}}"
                    style="min-width: 36px;" {{#if active}}disabled{{/if}}
                    hx-get="/material-categories/list?page={{number}}" hx-include="#category-page-size"
                    hx-target="#category-results" hx-swap="outerHTML">
                    {{number}}
                </button>

                {{/each}}

                <!-- Next Page -->
                <button type="button" class="btn btn-outline-secondary btn-sm" title="Next page" {{#unless
                    hasNext}}disabled{{/unless}} hx-get="/material-categories/list?page={{nextPage}}"
                    hx-include="#category-page-size" hx-target="#category-results" hx-swap="outerHTML">
                    <i class="bi bi-chevron-right"></i>
                </button>

                <!-- Last Page -->
                <button type="button" class="btn btn-outline-secondary btn-sm" title="Last page" {{#unless
                    hasNext}}disabled{{/unless}} hx-get="/material-categories/list?page={{lastPage}}"
                    hx-include="#category-page-size" hx-target="#category-results" hx-swap="outerHTML">
                    <i class="bi bi-chevron-double-right"></i>
                </button>

            </div>
        </nav>

    </div>

</div>