<div class="container-fluid marketplace-page py-4">

  <!-- Marketplace Introduction -->
  <div class="marketplace-banner mb-4">

    <div class="marketplace-banner-content">

      <h2 class="fw-bold mb-2">
        <i class="bi bi-shop me-2"></i>
        Construction Marketplace
      </h2>

      <p class="mb-0">
        Discover construction materials, explore suppliers, and compare prices
        and availability for your projects.
      </p>

    </div>

  </div>

  <!-- Marketplace Statistics -->
  <div class="row g-3 mb-4">

    <!-- Total Materials -->
    <div class="col-6 col-lg-3">
      <div class="marketplace-stat-card">

        <div class="marketplace-stat-icon">
          <i class="bi bi-box-seam"></i>
        </div>

        <div class="marketplace-stat-value">
          {{stats.total_materials}}
        </div>

        <div class="marketplace-stat-label">
          Materials
        </div>

      </div>
    </div>

    <!-- Total Suppliers -->
    <div class="col-6 col-lg-3">
      <div class="marketplace-stat-card">

        <div class="marketplace-stat-icon">
          <i class="bi bi-shop"></i>
        </div>

        <div class="marketplace-stat-value">
          {{stats.total_suppliers}}
        </div>

        <div class="marketplace-stat-label">
          Suppliers
        </div>

      </div>
    </div>

    <!-- Total Listings -->
    <div class="col-6 col-lg-3">
      <div class="marketplace-stat-card">

        <div class="marketplace-stat-icon">
          <i class="bi bi-card-list"></i>
        </div>

        <div class="marketplace-stat-value">
          {{stats.total_listings}}
        </div>

        <div class="marketplace-stat-label">
          Total Listings
        </div>

      </div>
    </div>

    <!-- Available Listings -->
    <div class="col-6 col-lg-3">
      <div class="marketplace-stat-card">

        <div class="marketplace-stat-icon">
          <i class="bi bi-check-circle"></i>
        </div>

        <div class="marketplace-stat-value">
          {{stats.available_listings}}
        </div>

        <div class="marketplace-stat-label">
          Available Listings
        </div>

      </div>
    </div>

  </div>

  <!-- Marketplace Browsing Options -->
  <h5 class="fw-bold mb-3">
    Explore Marketplace
  </h5>

  <div class="row g-4">

    <!-- Browse Materials -->
    <div class="col-md-6">

      <div class="marketplace-option-card">

        <div class="marketplace-option-icon">
          <i class="bi bi-box-seam"></i>
        </div>

        <h4 class="fw-bold">
          Browse Materials
        </h4>

        <p class="text-muted">
          Search construction materials and compare different suppliers based on
          their prices, available quantities, and availability.
        </p>

        <ul class="marketplace-feature-list">

          <li>
            <i class="bi bi-check-circle me-2"></i>
            Search materials by name or category
          </li>

          <li>
            <i class="bi bi-check-circle me-2"></i>
            Compare supplier prices
          </li>

          <li>
            <i class="bi bi-check-circle me-2"></i>
            Check available stock
          </li>

        </ul>

        <a
          href="/marketplace/materials"
          hx-get="/marketplace/materials"
          hx-target="#main"
          hx-swap="innerHTML"
          hx-push-url="true"
          class="btn btn-primary w-100 mt-auto"
        >

          Browse Materials
          <i class="bi bi-arrow-right ms-2"></i>

        </a>

      </div>

    </div>

    <!-- Browse Suppliers -->
    <div class="col-md-6">

      <div class="marketplace-option-card">

        <div class="marketplace-option-icon">
          <i class="bi bi-shop"></i>
        </div>

        <h4 class="fw-bold">
          Browse Suppliers
        </h4>

        <p class="text-muted">
          Discover construction suppliers and explore their individual
          storefronts, material catalogs, prices, and availability.
        </p>

        <ul class="marketplace-feature-list">

          <li>
            <i class="bi bi-check-circle me-2"></i>
            Search registered suppliers
          </li>

          <li>
            <i class="bi bi-check-circle me-2"></i>
            Explore supplier material catalogs
          </li>

          <li>
            <i class="bi bi-check-circle me-2"></i>
            View supplier contact information
          </li>

        </ul>

        <a
          href="/marketplace/suppliers"
          hx-get="/marketplace/suppliers"
          hx-target="#main"
          hx-swap="innerHTML"
          hx-push-url="true"
          class="btn btn-primary w-100 mt-auto"
        >

          Browse Suppliers
          <i class="bi bi-arrow-right ms-2"></i>

        </a>

      </div>

    </div>

  </div>

</div>