<div class="card border-success mb-4">

    <div class="card-header bg-light d-flex justify-content-between align-items-center">

        <h6 class="mb-0">
            <i class="bi bi-cart-plus me-2"></i>
            Purchase Order Handoff
        </h6>

        <button type="button" class="btn-close" aria-label="Close" data-requirement-close>
        </button>

    </div>

    <div class="card-body">

        <div class="alert alert-info">

            <i class="bi bi-info-circle me-2"></i>

            This requirement is ready for procurement preparation.
            Supplier selection and actual purchase order creation
            will be implemented in Phase B4.

        </div>

        <div class="row g-3">

            <div class="col-md-6">

                <div class="text-muted small mb-1">
                    Material
                </div>

                <div class="fw-semibold">
                    {{material_name}}
                </div>

            </div>

            <div class="col-md-6">

                <div class="text-muted small mb-1">
                    Material ID
                </div>

                <div>
                    {{material_id}}
                </div>

            </div>

            <div class="col-md-6">

                <div class="text-muted small mb-1">
                    Required Quantity
                </div>

                <div>
                    {{required_quantity_display}} {{unit}}
                </div>

            </div>

            <div class="col-md-6">

                <div class="text-muted small mb-1">
                    Required Date
                </div>

                <div>
                    {{required_date}}
                </div>

            </div>

            <div class="col-12">

                <div class="text-muted small mb-1">
                    Requirement ID
                </div>

                <div style="overflow-wrap: anywhere;">
                    {{requirement_id}}
                </div>

            </div>

        </div>

        <div class="d-flex justify-content-end mt-4">

            <button type="button" class="btn btn-outline-secondary" data-requirement-close>

                Close

            </button>

        </div>

    </div>

</div>