<div class="alert {{#if success}}alert-success{{else}}alert-danger{{/if}} alert-dismissible fade show" role="alert">

    <i class="bi {{#if success}}bi-check-circle{{else}}bi-exclamation-triangle{{/if}} me-2"></i>

    {{message}}

    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">
    </button>

</div>