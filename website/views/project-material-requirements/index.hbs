<div class="project-material-requirements-management">

    <!-- Section Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">

        <div>
            <h5 class="mb-1">Project Material Requirements</h5>

            <p class="text-muted mb-0">
                Manage materials required for construction activities.
            </p>
        </div>

        <button type="button" class="btn btn-primary" hx-get="/projects/{{project_id}}/material-requirements/new"
            hx-target="#requirement-form-container" hx-swap="innerHTML">

            <i class="bi bi-plus-lg me-1"></i>
            Add Requirement

        </button>

    </div>

    <!-- Add Requirement Form -->
    <div id="requirement-form-container"></div>

    <!-- Notifications -->
    <div id="requirement-message"></div>

    <!-- Filters -->
    <form id="requirement-filter-form" class="row g-2 align-items-end mb-3"
        hx-get="/projects/{{project_id}}/material-requirements/list" hx-target="#requirement-results"
        hx-swap="innerHTML" hx-trigger="input changed delay:350ms from:input[name='q'], change from:select">

        <!-- Search -->
        <div class="col-md-4">

            <label class="form-label small mb-1">
                Search Requirements
            </label>

            <input type="search" class="form-control" name="q" value="{{q}}"
                placeholder="Search material or activity..." autocomplete="off">

        </div>

        <!-- Activity Filter -->
        <div class="col-md-3">

            <label class="form-label small mb-1">
                Project Activity
            </label>

            <select class="form-select" name="activity_id">

                <option value="">
                    All Activities
                </option>

                {{#each activities}}

                <option value="{{activity_id}}" {{#if selected}}selected{{/if}}>
                    {{activity_name}}
                </option>

                {{/each}}

            </select>

        </div>

        <!-- Procurement Filter -->
        <div class="col-md-3">

            <label class="form-label small mb-1">
                Procurement Status
            </label>

            <select class="form-select" name="procurement">

                <option value="">
                    All Requirements
                </option>

                <option value="linked" {{#if linkedSelected}}selected{{/if}}>
                    Linked to PO
                </option>

                <option value="unlinked" {{#if unlinkedSelected}}selected{{/if}}>
                    Not Linked to PO
                </option>

            </select>

        </div>

        <!-- Page Size -->
        <div class="col-md-2">

            <label class="form-label small mb-1">
                Show Entries
            </label>

            <select class="form-select" name="page_size">

                {{#each pageSizeOptions}}

                <option value="{{value}}" {{#if selected}}selected{{/if}}>
                    {{value}}
                </option>

                {{/each}}

            </select>

        </div>

    </form>

    <!-- Results -->
    <div id="requirement-results" hx-get="/projects/{{project_id}}/material-requirements/list"
        hx-trigger="requirement-changed from:body" hx-include="#requirement-filter-form" hx-target="this"
        hx-swap="innerHTML">

        {{> project-material-requirements/results}}

    </div>

</div>