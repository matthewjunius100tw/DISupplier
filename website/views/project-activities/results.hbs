<!-- Project Activities Results -->

<div class="border rounded overflow-hidden mb-3">

    <!-- Column Headings -->
    <div class="row g-0 align-items-center bg-light border-bottom py-2 px-3 d-none d-lg-flex">

        <div class="col-lg-3 fw-semibold small">
            Activity Name
        </div>

        <div class="col-lg-2 fw-semibold small">
            Assigned To
        </div>

        <div class="col-lg-2 text-center fw-semibold small">
            Start Date
        </div>

        <div class="col-lg-2 text-center fw-semibold small">
            End Date
        </div>

        <div class="col-lg-1 text-center fw-semibold small">
            Status
        </div>

        <div class="col-lg-2 text-center fw-semibold small">
            Actions
        </div>

    </div>

    <!-- Activity Records -->
    {{#each activities}}

    <div class="border-bottom px-3 py-3">

        <div class="row g-2 align-items-center">


            <!-- Activity Name -->
            <div class="col-12 col-lg-3">

                <div class="d-flex align-items-center gap-2">

                    <!-- Expand / Collapse Button -->
                    {{#if description}}
                    <button type="button" class="btn btn-sm btn-outline-secondary detail-expand-btn"
                        data-bs-toggle="collapse" data-bs-target="#activity-details-{{activity_id}}"
                        aria-expanded="false" aria-controls="activity-details-{{activity_id}}"
                        aria-label="Toggle activity details" title="Show Activity Details">

                        <i class="bi bi-chevron-down" aria-hidden="true"></i>

                    </button>
                    {{/if}}

                    <!-- Activity Name -->
                    <div class="fw-semibold" style="overflow-wrap: anywhere;">
                        {{activity_name}}
                    </div>

                </div>

            </div>


            <!-- Assigned To -->
            <div class="col-6 col-lg-2">

                <span class="d-lg-none text-muted small d-block">
                    Assigned To
                </span>

                {{#if assigned_name}}
                {{assigned_name}}
                {{else}}
                <span class="text-muted">Unassigned</span>
                {{/if}}

            </div>

            <!-- Start Date -->
            <div class="col-6 col-lg-2 text-lg-center">

                <span class="d-lg-none text-muted small d-block">
                    Start Date
                </span>

                {{#if start_date}}
                {{start_date}}
                {{else}}
                -
                {{/if}}

            </div>

            <!-- End Date -->
            <div class="col-6 col-lg-2 text-lg-center">

                <span class="d-lg-none text-muted small d-block">
                    End Date
                </span>

                {{#if end_date}}
                {{end_date}}
                {{else}}
                -
                {{/if}}

            </div>

            <!-- Activity Status -->
            <div class="col-6 col-lg-1 text-lg-center">

                <span class="d-lg-none text-muted small d-block">
                    Status
                </span>

                <span class="badge {{status_badge}}">
                    {{status_name}}
                </span>

            </div>

            <!-- Activity Actions -->
            <div class="col-12 col-lg-2">

                <div class="d-flex justify-content-lg-center gap-2 mt-2 mt-lg-0">

                    <!-- Edit -->

                    <button type="button" class="btn btn-sm btn-outline-primary"
                        hx-get="/projects/{{project_id}}/activities/{{activity_id}}/edit"
                        hx-target="#activity-edit-{{activity_id}}" hx-swap="innerHTML">

                        <i class="bi bi-pencil-square me-1"></i>
                        Edit

                    </button>


                    <!-- Delete -->
                    <button type="button" class="btn btn-sm btn-outline-danger"
                        hx-delete="/projects/{{project_id}}/activities/{{activity_id}}"
                        hx-target="#activity-form-container" hx-swap="innerHTML"
                        hx-confirm="Are you sure you want to delete this activity?" hx-disabled-elt="this">

                        <i class="bi bi-trash me-1"></i>
                        Delete

                    </button>

                </div>

            </div>

        </div>


        <!-- Inline Edit Activity Container -->
        <div id="activity-edit-{{activity_id}}" class="mt-3"></div>




        <!-- Expandable Activity Details -->
        {{#if description}}

        <div class="collapse mt-3" id="activity-details-{{activity_id}}">

            <div class="bg-light rounded p-3">

                <!-- Section Heading -->
                <div class="fw-semibold mb-2">
                    <i class="bi bi-info-circle me-2"></i>
                    Activity Description
                </div>

                <!-- Description -->
                <div class="text-muted small" style="white-space: pre-line; overflow-wrap: anywhere;">
                    {{description}}
                </div>

            </div>

        </div>

        {{/if}}




    </div>

    {{else}}

    <!-- No Activities -->
    <div class="text-center text-muted py-4">

        <i class="bi bi-inbox me-2"></i>
        No activities found.

    </div>

    {{/each}}

</div>


<!-- Pagination -->
{{#if showPagination}}

<div class="d-flex justify-content-center mb-3">

    <nav aria-label="Project Activities pagination">

        <ul class="pagination pagination-sm mb-0 flex-wrap justify-content-center">

            <!-- First -->
            <li class="page-item {{#unless hasPrevious}}disabled{{/unless}}">

                {{#if hasPrevious}}

                <button type="button" class="page-link" hx-get="{{firstUrl}}" hx-target="#activity-results"
                    hx-swap="innerHTML">
                    First
                </button>

                {{else}}

                <span class="page-link">First</span>

                {{/if}}

            </li>

            <!-- Previous -->
            <li class="page-item {{#unless hasPrevious}}disabled{{/unless}}">

                {{#if hasPrevious}}

                <button type="button" class="page-link" hx-get="{{previousUrl}}" hx-target="#activity-results"
                    hx-swap="innerHTML">
                    Previous
                </button>

                {{else}}

                <span class="page-link">Previous</span>

                {{/if}}

            </li>

            <!-- Page Numbers -->
            {{#each pages}}

            <li class="page-item {{#if active}}active{{/if}}">

                {{#if active}}

                <span class="page-link" aria-current="page">
                    {{number}}
                </span>

                {{else}}

                <button type="button" class="page-link" hx-get="{{url}}" hx-target="#activity-results"
                    hx-swap="innerHTML">
                    {{number}}
                </button>

                {{/if}}

            </li>

            {{/each}}

            <!-- Next -->
            <li class="page-item {{#unless hasNext}}disabled{{/unless}}">

                {{#if hasNext}}

                <button type="button" class="page-link" hx-get="{{nextUrl}}" hx-target="#activity-results"
                    hx-swap="innerHTML">
                    Next
                </button>

                {{else}}

                <span class="page-link">Next</span>

                {{/if}}

            </li>

            <!-- Last -->
            <li class="page-item {{#unless hasNext}}disabled{{/unless}}">

                {{#if hasNext}}

                <button type="button" class="page-link" hx-get="{{lastUrl}}" hx-target="#activity-results"
                    hx-swap="innerHTML">
                    Last
                </button>

                {{else}}

                <span class="page-link">Last</span>

                {{/if}}

            </li>

        </ul>

    </nav>

</div>

{{/if}}


<!-- Record Counter -->
<div class="text-muted small text-end">

    Showing {{startRecord}}–{{endRecord}} of {{total}} activities

</div>