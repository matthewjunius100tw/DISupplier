<div class="project-activities-management">


    <!-- Section Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">

        <div>
            <h5 class="mb-1">Project Activities</h5>

            <p class="text-muted mb-0">
                Manage construction activities and schedules for this project.
            </p>
        </div>

        <!-- Add Activity Button -->
        <button type="button" class="btn btn-primary" hx-get="/projects/{{project_id}}/activities/new"
            hx-target="#activity-form-container" hx-swap="innerHTML">

            <i class="bi bi-plus-lg me-1"></i>
            Add Activity

        </button>

    </div>

    <!-- Add / Edit Activity Form Container -->
    <div id="activity-form-container"></div>

    <!-- Activity Search and Filters -->
    <form id="activity-filter-form" class="row g-2 align-items-end mb-3"
        hx-get="/projects/{{project_id}}/activities/list" hx-target="#activity-results" hx-swap="innerHTML"
        hx-trigger="input changed delay:350ms from:input[name='q'], change from:select">

        <!-- Search -->
        <div class="col-md-6">

            <label class="form-label small mb-1">
                Search Activities
            </label>

            <input type="search" class="form-control" name="q" value="{{q}}" placeholder="Search by activity name..."
                autocomplete="off">

        </div>

        <!-- Status Filter -->
        <div class="col-md-4">

            <label class="form-label small mb-1">
                Activity Status
            </label>

            <select class="form-select" name="status_id">

                <option value="" {{#if allStatusesSelected}}selected{{/if}}>
                    All Statuses
                </option>

                {{#each statuses}}

                <option value="{{status_id}}" {{#if selected}}selected{{/if}}>
                    {{status_name}}
                </option>

                {{/each}}

            </select>

        </div>

        <!-- Page Size -->
        <div class="col-md-2">

            <label class="form-label small mb-1">
                Show Entries
            </label>

            <select class="form-select" name="page_size">

                {{#each pageSizeOptions}}

                <option value="{{value}}" {{#if selected}}selected{{/if}}>
                    {{value}}
                </option>

                {{/each}}

            </select>

        </div>

    </form>


    <!-- HTMX Results Container -->
    <div id="activity-results" hx-get="/projects/{{project_id}}/activities/list" hx-trigger="activity-changed from:body"
        hx-include="#activity-filter-form" hx-target="this" hx-swap="innerHTML">

        {{> project-activities/results}}

    </div>


</div>