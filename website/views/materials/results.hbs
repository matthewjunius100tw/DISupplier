<div id="material-results">

    <!-- Page Size and Total Results -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <div class="d-flex align-items-center gap-2">
            <label for="material-page-size" class="form-label mb-0">
                Show
            </label>

            <select id="material-page-size" name="page_size" class="form-select form-select-sm" style="width: 90px;"
                hx-get="/materials/list" hx-trigger="change" hx-target="#material-results" hx-swap="outerHTML"
                hx-include="#material-category-filter, #material-search">

                {{#each pageSizeOptions}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>
                    {{value}}
                </option>
                {{/each}}

            </select>

            <span>per page</span>
        </div>

        <span class="text-muted">
            Total: {{total}} materials
        </span>
    </div>

    <!-- Material Table -->
    <div class="table-responsive">

        <table class="table table-striped table-hover align-middle"
            style="table-layout: fixed; width: 100%; min-width: 1250px;">

            <thead class="table-light">
                <tr>
                    <th style="width: 9%;">Material ID</th>
                    <th style="width: 27%;">Material Name</th>
                    <th style="width: 12%;">Category</th>
                    <th style="width: 7%;">Unit</th>
                    <th style="width: 17%;">Specification</th>
                    <th style="width: 7%;" class="text-center">Used In</th>
                    <th style="width: 9%;" class="text-center">Status</th>
                    <th style="width: 12%;" class="text-center">Actions</th>
                </tr>
            </thead>

            <tbody id="material-table-body">
                {{> materials/rows}}
            </tbody>

        </table>
    </div>



    <!-- Pagination Controls -->
    <div class="mt-3 mb-4">

        <!-- Results Information: right aligned below table -->
        <div class="text-end text-muted small mb-3">
            Showing {{startRecord}}–{{endRecord}} of {{total}} materials
        </div>

        <!-- Centered Pagination -->
        <nav aria-label="Material pagination" class="d-flex justify-content-center">

            <div class="d-flex align-items-center gap-1 flex-wrap justify-content-center">

                <!-- First Page -->
                <button type="button" class="btn btn-outline-secondary btn-sm" title="First page" {{#unless
                    hasPrevious}}disabled{{/unless}} hx-get="/materials/list?page={{firstPage}}"
                    hx-include="#material-category-filter, #material-search, #material-page-size"
                    hx-target="#material-results" hx-swap="outerHTML">
                    <i class="bi bi-chevron-double-left"></i>
                </button>

                <!-- Previous Page -->
                <button type="button" class="btn btn-outline-secondary btn-sm" title="Previous page" {{#unless
                    hasPrevious}}disabled{{/unless}} hx-get="/materials/list?page={{previousPage}}"
                    hx-include="#material-category-filter, #material-search, #material-page-size"
                    hx-target="#material-results" hx-swap="outerHTML">
                    <i class="bi bi-chevron-left"></i>
                </button>

                <!-- Five Consecutive Page Numbers -->
                {{#each pages}}

                <button type="button" class="btn btn-sm {{#if active}}btn-primary{{else}}btn-outline-secondary{{/if}}"
                    style="min-width: 36px;" {{#if active}}disabled{{/if}} hx-get="/materials/list?page={{number}}"
                    hx-include="#material-category-filter, #material-search, #material-page-size"
                    hx-target="#material-results" hx-swap="outerHTML">
                    {{number}}
                </button>

                {{/each}}

                <!-- Next Page -->
                <button type="button" class="btn btn-outline-secondary btn-sm" title="Next page" {{#unless
                    hasNext}}disabled{{/unless}} hx-get="/materials/list?page={{nextPage}}"
                    hx-include="#material-category-filter, #material-search, #material-page-size"
                    hx-target="#material-results" hx-swap="outerHTML">
                    <i class="bi bi-chevron-right"></i>
                </button>

                <!-- Last Page -->
                <button type="button" class="btn btn-outline-secondary btn-sm" title="Last page" {{#unless
                    hasNext}}disabled{{/unless}} hx-get="/materials/list?page={{lastPage}}"
                    hx-include="#material-category-filter, #material-search, #material-page-size"
                    hx-target="#material-results" hx-swap="outerHTML">
                    <i class="bi bi-chevron-double-right"></i>
                </button>

            </div>

        </nav>

    </div>

</div>