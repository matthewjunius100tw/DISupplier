<tr class="align-middle">

    <td colspan="8">

        <form hx-put="/materials/{{material_id}}" hx-target="closest tr" hx-swap="outerHTML">

            <div class="row g-2 align-items-end">

                <div class="col-md-2">
                    <label class="form-label">Material ID</label>
                    <input type="text" class="form-control" value="{{material_id}}" disabled>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Category</label>
                    <select name="category_id" class="form-select" required>
                        {{#each categories}}
                        <option value="{{category_id}}" {{#if selected}}selected{{/if}}>{{category_name}}</option>
                        {{/each}}
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Material Name</label>
                    <input type="text" name="material_name" class="form-control" value="{{material_name}}"
                        maxlength="150" required>
                </div>

                <div class="col-md-1">
                    <label class="form-label">Unit</label>
                    <input type="text" name="unit" class="form-control" value="{{unit}}" maxlength="30" required>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Specification</label>
                    <input type="text" name="specification" class="form-control" value="{{specification}}">
                </div>

                <div class="col-md-2 text-nowrap">
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="bi bi-check-lg"></i>
                        Save
                    </button>

                    <button type="button" class="btn btn-secondary btn-sm" hx-get="/materials/{{material_id}}/row"
                        hx-target="closest tr" hx-swap="outerHTML">
                        <i class="bi bi-x-lg"></i>
                        Cancel
                    </button>
                </div>

            </div>

        </form>

    </td>

</tr>
