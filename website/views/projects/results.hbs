<div id="project-results" hx-get="/projects/list" hx-trigger="project-changed from:body"
    hx-include="#project-company-filter, #project-status-filter, #project-search, #project-page-size" hx-target="this"
    hx-swap="outerHTML">

    <!-- Page Size and Total Results -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <div class="d-flex align-items-center gap-2">

            <label for="project-page-size" class="form-label mb-0">
                Show
            </label>

            <select id="project-page-size" name="page_size" class="form-select form-select-sm" style="width: 90px;"
                hx-get="/projects/list" hx-trigger="change" hx-target="#project-results" hx-swap="outerHTML"
                hx-include="#project-company-filter, #project-status-filter, #project-search">

                {{#each pageSizeOptions}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>
                    {{value}}
                </option>
                {{/each}}

            </select>

            <span>per page</span>

        </div>

        <span class="text-muted">
            Total: {{total}} projects
        </span>

    </div>

    <!-- Project Table -->
    <div class="table-responsive">

        <table class="table table-striped table-hover align-middle"
            style="table-layout: fixed; width: 100%; min-width: 1100px;">

            <thead class="table-light">
                <tr>
                    <th style="width: 23%;">Project</th>
                    <th style="width: 21%;">Company</th>
                    <th style="width: 17%;">Location</th>
                    <th style="width: 17%;">Period</th>
                    <th style="width: 9%;" class="text-center">Status</th>
                    <th style="width: 13%;" class="text-center">Actions</th>
                </tr>
            </thead>

            {{> projects/rows}}

        </table>

    </div>

    <!-- Pagination Controls -->
    <div class="mt-3 mb-4">

        <!-- Results Information -->
        <div class="text-end text-muted small mb-3">
            Showing {{startRecord}}–{{endRecord}} of {{total}} projects
        </div>

        <!-- Centered Pagination -->
        <nav aria-label="Project pagination" class="d-flex justify-content-center">

            <div class="d-flex align-items-center gap-1 flex-wrap justify-content-center">

                <!-- First Page -->
                <button type="button" class="btn btn-outline-secondary btn-sm" title="First page" {{#unless
                    hasPrevious}}disabled{{/unless}} hx-get="/projects/list?page={{firstPage}}"
                    hx-include="#project-company-filter, #project-status-filter, #project-search, #project-page-size"
                    hx-target="#project-results" hx-swap="outerHTML">
                    <i class="bi bi-chevron-double-left"></i>
                </button>

                <!-- Previous Page -->
                <button type="button" class="btn btn-outline-secondary btn-sm" title="Previous page" {{#unless
                    hasPrevious}}disabled{{/unless}} hx-get="/projects/list?page={{previousPage}}"
                    hx-include="#project-company-filter, #project-status-filter, #project-search, #project-page-size"
                    hx-target="#project-results" hx-swap="outerHTML">
                    <i class="bi bi-chevron-left"></i>
                </button>

                <!-- Up to Five Consecutive Pages -->
                {{#each pages}}

                <button type="button" class="btn btn-sm {{#if active}}btn-primary{{else}}btn-outline-secondary{{/if}}"
                    style="min-width: 36px;" {{#if active}}disabled{{/if}} hx-get="/projects/list?page={{number}}"
                    hx-include="#project-company-filter, #project-status-filter, #project-search, #project-page-size"
                    hx-target="#project-results" hx-swap="outerHTML">
                    {{number}}
                </button>

                {{/each}}

                <!-- Next Page -->
                <button type="button" class="btn btn-outline-secondary btn-sm" title="Next page" {{#unless
                    hasNext}}disabled{{/unless}} hx-get="/projects/list?page={{nextPage}}"
                    hx-include="#project-company-filter, #project-status-filter, #project-search, #project-page-size"
                    hx-target="#project-results" hx-swap="outerHTML">
                    <i class="bi bi-chevron-right"></i>
                </button>

                <!-- Last Page -->
                <button type="button" class="btn btn-outline-secondary btn-sm" title="Last page" {{#unless
                    hasNext}}disabled{{/unless}} hx-get="/projects/list?page={{lastPage}}"
                    hx-include="#project-company-filter, #project-status-filter, #project-search, #project-page-size"
                    hx-target="#project-results" hx-swap="outerHTML">
                    <i class="bi bi-chevron-double-right"></i>
                </button>

            </div>
        </nav>

    </div>

</div>