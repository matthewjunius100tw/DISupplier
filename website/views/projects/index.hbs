<div class="mt-4">

    <h2 class="mb-3">
        <i class="bi bi-kanban me-2"></i>
        Projects
    </h2>

    <!-- Error messages from the server (validation, delete warnings) -->
    <div id="project-message"></div>

    <!-- Filters and keyword search: only the table body is reloaded -->
    <div class="row g-2 mb-3">

        <div class="col-md-3">
            <select id="project-company-filter" name="company_id" class="form-select"
                hx-get="/projects/list" hx-trigger="change" hx-target="#project-table-body"
                hx-include="#project-status-filter, #project-search">
                <option value="">All companies</option>
                {{#each companies}}
                <option value="{{company_id}}">{{company_name}}</option>
                {{/each}}
            </select>
        </div>

        <div class="col-md-3">
            <select id="project-status-filter" name="status_id" class="form-select"
                hx-get="/projects/list" hx-trigger="change" hx-target="#project-table-body"
                hx-include="#project-company-filter, #project-search">
                <option value="">All statuses</option>
                {{#each statuses}}
                <option value="{{status_id}}">{{status_name}}</option>
                {{/each}}
            </select>
        </div>

        <div class="col-md-6">
            <input id="project-search" type="search" name="q" class="form-control"
                placeholder="Search by project name or location..."
                hx-get="/projects/list" hx-trigger="input delay:300ms" hx-target="#project-table-body"
                hx-include="#project-company-filter, #project-status-filter">
        </div>

    </div>


    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">

            <thead class="table-light">
                <tr>
                    <th>Project</th>
                    <th>Company</th>
                    <th>Location</th>
                    <th>Period</th>
                    <th>Status</th>
                    <th>Members</th>
                    <th>Orders</th>
                </tr>
            </thead>

            <tbody id="project-table-body">
                {{> projects/rows}}
            </tbody>

        </table>
    </div>

</div>
