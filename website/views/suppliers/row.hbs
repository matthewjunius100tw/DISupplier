<tbody id="supplier-{{supplier_id}}">

    <!-- Main Supplier Row -->
    <tr class="align-middle">

        <!-- Supplier ID -->
        <td>
            <code>{{supplier_id}}</code>
        </td>

        <!-- Supplier Name and Expand Button -->
        <td>
            <div class="d-flex align-items-center gap-2">

                <button type="button" class="btn btn-sm btn-outline-secondary" title="Show supplier information"
                    aria-label="Toggle details for {{supplier_name}}" aria-expanded="false"
                    aria-controls="supplier-details-{{supplier_id}}" onclick="
                            const details = document.getElementById('supplier-details-{{supplier_id}}');
                            const expanded = details.classList.toggle('d-none') === false;
                            this.setAttribute('aria-expanded', String(expanded));
                            this.querySelector('i').className =
                                expanded ? 'bi bi-chevron-up' : 'bi bi-chevron-down';
                        ">
                    <i class="bi bi-chevron-down"></i>
                </button>

                <span>{{supplier_name}}</span>

            </div>
        </td>

        <!-- Related Materials and Purchase Orders -->
        <td>
            <span class="badge bg-secondary">
                {{usage_count}}
            </span>
        </td>

        <!-- Status -->
        <td class="text-nowrap">

            <button type="button" class="btn btn-sm {{#if is_active}}btn-primary{{else}}btn-secondary{{/if}}"
                hx-put="/suppliers/{{supplier_id}}/status" hx-target="closest tbody" hx-swap="outerHTML"
                hx-confirm="Are you sure you want to change this supplier's status?">

                {{#if is_active}}

                <i class="bi bi-check-circle me-1"></i>
                Active

                {{else}}

                <i class="bi bi-dash-circle me-1"></i>
                Inactive

                {{/if}}

            </button>

        </td>

        <!-- Actions -->
        <td class="text-nowrap">

            <!-- Edit -->
            <button type="button" class="btn btn-primary btn-sm" hx-get="/suppliers/{{supplier_id}}/edit"
                hx-target="closest tbody" hx-swap="outerHTML">

                <i class="bi bi-pencil-square me-1"></i>
                Edit
            </button>

            <!-- Delete -->
            {{#if usage_count}}

            <button type="button" class="btn btn-secondary btn-sm ms-2" disabled
                title="Cannot delete: this supplier has related materials or purchase orders.">

                <i class="bi bi-lock me-1"></i>
                Delete
            </button>

            {{else}}

            <button type="button" class="btn btn-danger btn-sm ms-2" hx-delete="/suppliers/{{supplier_id}}"
                hx-target="closest tbody" hx-swap="outerHTML"
                hx-confirm="Are you sure you want to permanently delete this supplier?" hx-on::after-request="
                        if (event.detail.successful) {
                            document.getElementById('supplier-search')
                                .dispatchEvent(new Event('input', { bubbles: true }));
                        }
                    ">

                <i class="bi bi-trash3 me-1"></i>
                Delete
            </button>

            {{/if}}

        </td>

    </tr>

    <!-- Expandable Supplier Information -->
    <tr id="supplier-details-{{supplier_id}}" class="d-none">

        <td colspan="5">

            <div class="border rounded p-3 bg-light">

                <h6 class="mb-3">
                    <i class="bi bi-info-circle me-2"></i>
                    Supplier Information
                </h6>

                <div class="row g-3">

                    <!-- Email -->
                    <div class="col-md-6">
                        <div class="small text-muted mb-1">
                            Email
                        </div>
                        <div>{{email}}</div>
                    </div>

                    <!-- Phone -->
                    <div class="col-md-6">
                        <div class="small text-muted mb-1">
                            Phone
                        </div>
                        <div>{{phone}}</div>
                    </div>

                    <!-- Address -->
                    <div class="col-md-6">
                        <div class="small text-muted mb-1">
                            Address
                        </div>
                        <div style="white-space: pre-wrap;">{{address}}</div>
                    </div>

                    <!-- Website -->
                    <div class="col-md-6">
                        <div class="small text-muted mb-1">
                            Website
                        </div>

                        {{#if website}}
                        <div>{{website}}</div>
                        {{else}}
                        <span class="text-muted">Not provided</span>
                        {{/if}}

                    </div>

                    <!-- Relationship Summary -->
                    <div class="col-12">
                        <hr class="my-2">

                        <div class="d-flex flex-wrap gap-4 small">

                            <span>
                                <strong>Materials:</strong>
                                {{material_count}}
                            </span>

                            <span>
                                <strong>Purchase Orders:</strong>
                                {{order_count}}
                            </span>

                        </div>
                    </div>

                </div>

            </div>

        </td>

    </tr>

</tbody>