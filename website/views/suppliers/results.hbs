<div id="supplier-results">

    <!-- Page Size and Total Results -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <div class="d-flex align-items-center gap-2">

            <label for="supplier-page-size" class="form-label mb-0">
                Show
            </label>

            <select id="supplier-page-size" name="page_size" class="form-select form-select-sm" style="width: 90px;"
                hx-get="/suppliers/list" hx-trigger="change" hx-target="#supplier-results" hx-swap="outerHTML"
                hx-include="#supplier-search">

                {{#each pageSizeOptions}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>
                    {{value}}
                </option>
                {{/each}}

            </select>

            <span>per page</span>
        </div>

        <span class="text-muted">
            Total: {{total}} suppliers
        </span>

    </div>

    <!-- Supplier Table -->
    <div class="table-responsive">

        <table class="table table-striped table-hover align-middle" style="table-layout: fixed; width: 100%;">
            <thead class="table-light">
                <tr>
                    <th style="width: 13%;">Supplier ID</th>
                    <th style="width: 42%;">Supplier Name</th>
                    <th style="width: 12%;" class="text-center">Used In</th>
                    <th style="width: 13%;" class="text-center">Status</th>
                    <th style="width: 20%;" class="text-center">Actions</th>
                </tr>
            </thead>

            {{> suppliers/rows}}

        </table>

    </div>



    <!-- Pagination Controls -->
    <div class="mt-3 mb-4">

        <!-- Results Information: right aligned below table -->
        <div class="text-end text-muted small mb-3">
            Showing {{startRecord}}–{{endRecord}} of {{total}} suppliers
        </div>

        <!-- Centered Pagination -->
        <nav aria-label="Supplier pagination" class="d-flex justify-content-center">

            <div class="d-flex align-items-center gap-1 flex-wrap justify-content-center">

                <!-- First Page -->
                <button type="button" class="btn btn-outline-secondary btn-sm" title="First page" {{#unless
                    hasPrevious}}disabled{{/unless}} hx-get="/suppliers/list?page={{firstPage}}"
                    hx-include="#supplier-search, #supplier-page-size" hx-target="#supplier-results"
                    hx-swap="outerHTML">
                    <i class="bi bi-chevron-double-left"></i>
                </button>

                <!-- Previous Page -->
                <button type="button" class="btn btn-outline-secondary btn-sm" title="Previous page" {{#unless
                    hasPrevious}}disabled{{/unless}} hx-get="/suppliers/list?page={{previousPage}}"
                    hx-include="#supplier-search, #supplier-page-size" hx-target="#supplier-results"
                    hx-swap="outerHTML">
                    <i class="bi bi-chevron-left"></i>
                </button>

                <!-- Five Consecutive Page Numbers -->
                {{#each pages}}

                <button type="button" class="btn btn-sm {{#if active}}btn-primary{{else}}btn-outline-secondary{{/if}}"
                    style="min-width: 36px;" {{#if active}}disabled{{/if}} hx-get="/suppliers/list?page={{number}}"
                    hx-include="#supplier-search, #supplier-page-size" hx-target="#supplier-results"
                    hx-swap="outerHTML">
                    {{number}}
                </button>

                {{/each}}

                <!-- Next Page -->
                <button type="button" class="btn btn-outline-secondary btn-sm" title="Next page" {{#unless
                    hasNext}}disabled{{/unless}} hx-get="/suppliers/list?page={{nextPage}}"
                    hx-include="#supplier-search, #supplier-page-size" hx-target="#supplier-results"
                    hx-swap="outerHTML">
                    <i class="bi bi-chevron-right"></i>
                </button>

                <!-- Last Page -->
                <button type="button" class="btn btn-outline-secondary btn-sm" title="Last page" {{#unless
                    hasNext}}disabled{{/unless}} hx-get="/suppliers/list?page={{lastPage}}"
                    hx-include="#supplier-search, #supplier-page-size" hx-target="#supplier-results"
                    hx-swap="outerHTML">
                    <i class="bi bi-chevron-double-right"></i>
                </button>

            </div>

        </nav>

    </div>

</div>